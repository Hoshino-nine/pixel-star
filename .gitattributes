# PixelStar - 跨平台行尾与文件类型规范
# 防止 Windows 上 git 自动 CRLF 化 Bash 脚本导致 Linux/macOS 执行失败 (bad interpreter '/usr/bin/env bash\r')

# 默认：让 git 自动判断文本/二进制 + 提交时归一化为 LF
* text=auto eol=lf

# Shell / Bash / 其他 Unix-only 脚本：强制 LF
*.sh        text eol=lf
*.bash      text eol=lf

# Windows-only 脚本：保持 CRLF（PowerShell 兼容性最好）
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# CMake / 构建脚本：统一 LF（CMake 跨平台原生支持）
CMakeLists.txt    text eol=lf
*.cmake           text eol=lf

# 常见源代码：归一化为 LF
*.c         text eol=lf diff=cpp
*.h         text eol=lf diff=cpp
*.cpp       text eol=lf diff=cpp
*.cxx       text eol=lf diff=cpp
*.cc        text eol=lf diff=cpp
*.hpp       text eol=lf diff=cpp
*.hxx       text eol=lf diff=cpp
*.java      text eol=lf diff=java
*.kt        text eol=lf diff=java
*.py        text eol=lf diff=python

# 文档与配置：LF
*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf

# 二进制：明确标记，不做行尾转换、不进 diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.pdf       binary
*.so        binary
*.dll       binary
*.dylib     binary
*.a         binary
*.lib       binary
*.exe       binary
*.apk       binary
*.aab       binary
*.pxs       binary
